{
  "name": "gather-cloudflare-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create gather-school-data",
    "db:migrate:local": "wrangler d1 migrations apply gather-school-data --local",
    "db:migrate:remote": "wrangler d1 migrations apply gather-school-data --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
